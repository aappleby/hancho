# pyright: reportAttributeAccessIssue=false
import hancho

compile_cpp = hancho.Dict(
    name       = "compile_cpp",
    desc       = "Compiling C++ {in_src} -> {out_obj}",
    command    = "g++ -MMD -c {in_src} -o {out_obj}",
    in_src     = None,
    in_depfile = "{swapext(out_obj, '.d')}",
    out_obj    = "{swapext(in_src, '.o')}",
)

link_cpp_bin = dict(
    name     = "link_cpp_bin",
    command  = "g++ -Wl,--start-group {in_objs} -Wl,--end-group -o {out_bin}",
    in_objs  = None,
)
