# examples/subrepos/build.hancho

myrepo = load_repo("myrepo/build.hancho")

main_o = Task(
    desc    = "Compile {basename(out_obj)}",
    command = "g++ -c {in_src} -o {out_obj}",
    in_src  = "main.cpp",
    out_obj = "{swapext(in_src, '.o')}"
)

main = Task(
    desc    = "Link [{basename(in_obj)}] -> {basename(out_bin)}",
    command = "g++ {in_obj} -o {out_bin}",
    in_obj  = [main_o, myrepo.util_o],
    out_bin = "main",
)
