# This example demonstrates how to manage multiple build types (debug, release, profile...) in
# Hancho.

# We build "Hello World" for x64, Arm, and Risc-V in debug, fastbuild, and release builds.
platform = ["rv64", "aarch64", ""]

# x86_64-pc-linux-gnu x86-64 x86_64

tools = load_script("{hancho.root}/tools/tools_base.hancho")

main_o   = Task(tools.compile_cpp,  in_src = "main.cpp")
main_bin = Task(tools.link_cpp_bin, in_obj = main_o)
