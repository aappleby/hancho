# examples/hello_world/build.hancho

compile_cpp = Tool(
    desc    = "Compiling {basename(in_src)} -> {basename(out_obj)}",
    command = "g++ -MMD -c {in_src} -o {out_obj}",
    out_obj = "{swapext(in_src, '.o')}",
    in_depfile = "{swapext(out_obj, '.d')}",
)

main_o = compile_cpp(in_src = "main.cpp")
util_o = compile_cpp(in_src = "util.cpp")

link_cpp_bin = Tool(
    desc    = "Linking {basename(out_bin)}",
    command = "g++ {in_objs} -o {out_bin}"
)

main_app = link_cpp_bin(in_objs = [main_o, util_o], out_bin = "hello_world")
