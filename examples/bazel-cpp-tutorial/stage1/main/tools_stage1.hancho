# examples/bazel-cpp-tutorial/stage1/main/tools_stage1.hancho

# Hancho doesn't come with any built-in rules, so we have to define the ones we need here.
# This 'cc_binary' rule was extracted from Bazel via "bazel -s //main:hello_world".

gcc_flags = [
    "-U_FORTIFY_SOURCE",
    "-fstack-protector",
    "-Wall",
    "-Wunused-but-set-parameter",
    "-Wno-free-nonheap-object",
    "-fno-omit-frame-pointer",
    "-std=c++14",
    "-MMD -MF {in_depfile}",
    "-frandom-seed={out_obj}",
    "-fPIC",
    "-iquote .",
    "-fno-canonical-system-headers",
    "-Wno-builtin-macro-redefined",
    "-D__DATE__=\"redacted\"",
    "-D__TIMESTAMP__=\"redacted\"",
    "-D__TIME__=\"redacted\"",
]

ld_flags = [
    "-Wl,-S",
    "-Wl,-no-as-needed",
    "-Wl,-z,relro,-z,now",
    "-fuse-ld=gold",
    "-B/usr/bin",
    "-pass-exit-codes",
]

ld_libs = [
    "-Wl,--push-state,-as-needed -lstdc++ -Wl,--pop-state",
    "-Wl,--push-state,-as-needed -lm      -Wl,--pop-state",
]

compile_cpp = Tool(
    desc       = "Compiling {basename(in_src)} -> {basename(out_obj)}",
    command    = "g++ {gcc_flags} -c {in_src} -o {out_obj}",
    #----------
    gcc_flags  = gcc_flags,
    #----------
    in_src     = ___,
    in_depfile = "{swapext(out_obj, '.d')}",
    out_obj    = "{swapext(in_src, '.o')}",
)

link_cpp_bin = Tool(
    desc     = "Linking {basename(in_objs)} -> {basename(out_bin)}",
    command  = "gcc {ld_flags} {in_objs} -o {out_bin} {ld_libs}",
    #----------
    ld_flags = ld_flags,
    ld_libs  = ld_libs,
    #----------
    in_objs  = ___,
    out_bin  = ___,
)

def cc_binary(*, out_bin, in_srcs):
    objs = [compile_cpp(in_src = src) for src in leaves(in_srcs)]
    bin = link_cpp_bin(out_bin = out_bin, in_objs = objs)
    return bin
