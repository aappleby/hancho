# examples/dynamic_dependencies/filelist/build.hancho

import os
import random
from contextlib import chdir
from glob import glob

import hancho

dirname = hancho.Path.dirname
original_cwd = os.getcwd()

src_files = glob("src/*")

def touch_in_src(task):
    for src in task.in_src:
        #print(src)
        os.utime(src, None)

touch_inputs = hancho.Tool(
    desc = "Touch {basename(in_src)}",
    command = touch_in_src,
    in_src = None,
)

random_touch = touch_inputs(in_src = random.sample(src_files, 3))

def generate_filelist(task):
    with chdir(dirname(__file__)), open(task.out_list, "w", encoding="utf-8") as file:
        for f in random.sample(task.in_src, 3):
            print(f)
            file.write(str(f) + "\n")

filelist_txt = hancho.Task(
    desc     = "Write the names of 3 random files in src/ to {basename(out_list)}",
    command  = generate_filelist,
    in_src   = src_files,
    out_list = "filelist.txt",
)

def generate_result(task):
    """Read build/filelist.txt and create a new task to cat those files together into {basename(out_files)}"""

    with chdir(dirname(__file__)), open(task.in_filelist, encoding="utf-8") as file:

        from_filelist = [f.strip() for f in file.readlines()]
        print(os.getcwd())
        print(from_filelist)

        new_task = hancho.Task(
            desc      = "Concatenate {basename(in_files)} into {basename(out_files)}",
            command   = "cat {in_files} > {out_files}",
            in_files  = from_filelist,
            in_deps   = [random_touch, filelist_txt],
            out_files = "result.txt",
            cwd = os.getcwd(),
        )

    hancho.Task(
        desc    = "Copy {basename(in_text)} -> {basename(out_cat)}",
        command = "cat {in_text} >> {out_cat}",
        in_text = new_task,
        out_cat = "result2.txt"
    )

result_txt = hancho.Task(
    desc        = "Generate a new task from {basename(in_filelist)}",
    command     = generate_result,
    in_filelist = filelist_txt,
)
