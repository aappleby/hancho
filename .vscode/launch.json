{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

    {
      "name"    : "Debug one test",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "args"    : ["tests.test_split.TestSplit.test_alternate_delims", "-vvv"],
      "preLaunchTask": "Wipe build",
    },

    {
      "name"    : "Debug all tests",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "preLaunchTask": "Wipe build",
    },

    {
      "name"    : "Debug scratch/build.py",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/scratch/build.py",
      "cwd"     : "${workspaceFolder}/scratch",
      "args"    : ["-D"],
      //"preLaunchTask": "Wipe build",
    },

    {
      "name"    : "Debug scratch/build.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/scratch",
      "args"    : ["-D", "-V", "-T", "--hancho.flerp=120"],
      //"args"    : ["-D", "-V"],
      //"preLaunchTask": "Wipe build",
      "variablePresentation": {
        "all": "hide",
        "protected": "group",
      }
    },

    {
      "name"    : "Debug tricks/trick4_codegen_pipeline.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/tricks",
      "args"    : ["-s=trick4_codegen_pipeline.hancho"],
      //"args"    : ["--trace"],
      "preLaunchTask": "Wipe build",
    },


    {
      "name"    : "Debug example hello_world",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/examples/hello_world",
      "args"    : ["--verbose"],
      //"args"    : ["--trace"],
      //"preLaunchTask": "Wipe build",
    },

    {
      "name"    : "Debug hancho.py",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "hancho",
      //"program" : "${workspaceFolder}/hancho.py",
      //"cwd"     : "${workspaceFolder}/examples/dynamic_dependencies",
      "args"    : ["-D"],
      //"preLaunchTask": "Wipe build",
    },

    {
      "name"    : "Debug example",
      "type"    : "debugpy",
      "request" : "launch",
      //"module"  : "hancho",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/examples/subrepos",
      "args"    : ["-D"],
      "preLaunchTask": "Wipe build",
    },

    {
      // python -m unittest discover -s tests
      "name": "All tests in ${workspaceFolder}/tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover"],
      "cwd": "${workspaceFolder}/tests",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "preLaunchTask": "Wipe build",
    },

    {
      "name": "Megabuild",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd": "${workspaceFolder}/..",
      //"args": ["--force", "-j1"],
      "preLaunchTask": "Wipe build",
    },
  ]
}
