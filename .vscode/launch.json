{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

    {
      "name"    : "Debug hancho.py",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "hancho",
      //"cwd"     : "${workspaceFolder}/examples/dynamic_dependencies",
      "console" : "internalConsole",
      "args"    : ["-ldebug"],
      "preLaunchTask": "wipe_workspace_build"
    },

    {
      "name"    : "Debug scratch/build.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/scratch",
      "console" : "internalConsole",
      //"args"    : ["-ltrace", "--floobert=schoobert", "--train.goes=choochoo", "--project.spargy=3484"],
      //"args"    : ["-ltrace", "--log_width=120"],
      "args"    : ["-ldebug", "--log_width=120"],
      //"preLaunchTask": "wipe_scratch_build"
    },

    {
      "name"    : "Debug one test",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "console" : "internalConsole",
      "args"    : ["tests.test_tasks.TestTasks.test_jobs", "-vvv"],
      "preLaunchTask" : "wipe_test_build",
    },

    {
      "name"    : "Debug all tests",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "console" : "internalConsole",
    },

    {
      "name"    : "Debug scratch/build.py",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/scratch/build.py",
      "cwd"     : "${workspaceFolder}/scratch",
      "console" : "internalConsole",
      "args"    : ["-D"],
    },

    {
      "name"    : "Debug tricks/trick4_codegen_pipeline.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/tricks",
      "console" : "internalConsole",
      "args"    : ["-s=trick4_codegen_pipeline.hancho"],
      //"args"    : ["--trace"],
    },


    {
      "name"    : "Debug example hello_world",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/examples/hello_world",
      "console" : "internalConsole",
      "args"    : ["--verbose"],
      //"args"    : ["--trace"],
    },

    {
      "name"    : "Debug example",
      "type"    : "debugpy",
      "request" : "launch",
      //"module"  : "hancho",
      "program" : "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/examples/subrepos",
      "console" : "internalConsole",
      "args"    : ["-D"],
    },

    {
      // python -m unittest discover -s tests
      "name": "All tests in ${workspaceFolder}/tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover"],
      "cwd": "${workspaceFolder}/tests",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console" : "internalConsole",
    },

    {
      "name": "Megabuild",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd": "${workspaceFolder}/..",
      "console" : "internalConsole",
      //"args": ["--force", "-j1"],
    },
  ]
}
