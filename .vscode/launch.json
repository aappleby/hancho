{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

    {
      "name"    : "Debug hancho.py",
      "type"    : "debugpy",
      "request" : "launch",
      "program": "${workspaceFolder}/hancho.py",
      "console" : "internalConsole",
      "args"    : ["-ldebug"],
      "preLaunchTask": "wipe_workspace_build"
    },

//    {
//      "name"    : "Debug scratch/build.hancho",
//      "type"    : "debugpy",
//      "request" : "launch",
//      "program": "${workspaceFolder}/hancho.py",
//      "cwd"     : "${workspaceFolder}/scratch",
//      "console" : "internalConsole",
//      //"args"    : ["-ltrace", "--floobert=schoobert", "--train.goes=choochoo", "--project.spargy=3484"],
//      //"args"    : ["-ltrace", "--log_width=120"],
//      "args"    : ["-ldebug", "--log_width=120"],
//      //"preLaunchTask": "wipe_scratch_build"
//    },

    {
      "name"    : "Debug scratch/build.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}",
      "console" : "internalConsole",
      //"args"    : ["-ltrace", "--floobert=schoobert", "--train.goes=choochoo", "--project.spargy=3484"],
      //"args"    : ["-ltrace", "--log_width=120"],
      "args"    : ["-ldebug", "--log_width=120", "-f=scratch/build.hancho"],
      //"preLaunchTask": "wipe_scratch_build"
    },

    {
      "name"    : "Debug one test",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "args"    : ["discover", "-s", "tests", "-k", "${input:testName}"],
      "console" : "internalConsole"
    },

    {
      "name"    : "Debug all tests",
      "type"    : "debugpy",
      "request" : "launch",
      "module"  : "unittest",
      "console" : "internalConsole",
    },

    {
      "name"    : "Debug scratch/build.py",
      "type"    : "debugpy",
      "request" : "launch",
      "program" : "${workspaceFolder}/scratch/build.py",
      "cwd"     : "${workspaceFolder}/scratch",
      "console" : "internalConsole",
      "args"    : ["-D"],
    },

    {
      "name"    : "Debug tricks/trick4_codegen_pipeline.hancho",
      "type"    : "debugpy",
      "request" : "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/tricks",
      "console" : "internalConsole",
      "args"    : ["-s=trick4_codegen_pipeline.hancho"],
      //"args"    : ["--trace"],
    },


    {
      "name"    : "Debug example",
      "type"    : "debugpy",
      "request" : "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd"     : "${workspaceFolder}/examples/bazel-cpp-tutorial/stage3",
      "console" : "internalConsole",
      "args"    : ["--log_level=debug", "--max_jobs=1"],
      //"args"    : ["-ltrace"],
    },

    {
      // python -m unittest discover -s tests
      "name": "All tests in ${workspaceFolder}/tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover"],
      "cwd": "${workspaceFolder}/tests",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console" : "internalConsole",
    },

    {
      "name": "Megabuild",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hancho.py",
      "cwd": "${workspaceFolder}/..",
      "console" : "internalConsole",
      //"args": ["--force", "-j1"],
    },
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Enter test method or class name pattern (e.g., test_good_build_path)",
      "default": "test_good_build_path"
    }
  ]
}
