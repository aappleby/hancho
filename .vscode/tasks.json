    {
      // Wipe all build directories in the workspace
      "label": "wipe_workspace_build",
      "type": "shell",
      "command": "find . -type d -name build -prune -exec rm -rf {} +",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },

    {
      // Wipe all build directories in /scratch
      "label": "wipe_scratch_build",
      "type": "shell",
      "command": "find . -type d -name build -prune -exec rm -rf {} +",
      "options": {
        "cwd": "${workspaceFolder}/scratch"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    }
  ]
}
